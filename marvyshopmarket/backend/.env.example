# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.
FLASK_ENV=development
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
SQLALCHEMY_DATABASE_URI=mysql+mysqldb://usuario:clave@host:3306/bd?charset=utf8mb4
# Debe incluir el nombre de la base de datos (p. ej. /tienda)
MONGO_URI=mongodb+srv://usuario:clave@cluster.mongodb.net/tienda?retryWrites=true&w=majority
# Opcionales
# UPLOAD_FOLDER=/app/uploads
# CORS_ORIGINS=http://localhost:5173,https://marvyshopmarket.com
